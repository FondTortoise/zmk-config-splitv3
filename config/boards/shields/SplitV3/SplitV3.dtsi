#include <dt-bindings/zmk/matrix_transform.h>
#include <physical_layouts.dtsi>

/ {
    chosen {
        zmk,kscan = &kscan;
        zmk,matrix_transform = &transform;
        zmk,battery = &vbatt;
        zephyr,display = &oled;
        zmk,physical-layout = &layout;
    };

    vbatt: vbatt {
        compatible = "zmk,battery-nrf-vddh";
    };

    kscan: kscan {
        compatible = "zmk,kscan-gpio-matrix";
        label = "kscan";
        diode-direction = "col2row";
        wakeup-source;

        row-gpios = <&gpio1 6 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>,
                    <&gpio1 4 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>,
                    <&gpio0 11 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>,
                    <&gpio1 0 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>,
                    <&gpio0 24 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>,
                    <&gpio0 22 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>;
    };

    transform: matrix_transform {
        compatible = "zmk,matrix-transform";
        rows = <6>;
        columns = <14>;

        map = <
                RC(0, 0) RC(0, 1) RC(0, 2) RC(0, 3) RC(0, 4) RC(0, 5) RC(0, 6) RC(0, 7) RC(0, 8) RC(0, 9) RC(0, 10) RC(0, 11) RC(0, 12) RC(0, 13)
                RC(1, 0) RC(1, 1) RC(1, 2) RC(1, 3) RC(1, 4) RC(1, 5) RC(1, 6) RC(1, 7) RC(1, 8) RC(1, 9) RC(1, 10) RC(1, 11) RC(1, 12) RC(1, 13)
                RC(2, 0) RC(2, 1) RC(2, 2) RC(2, 3) RC(2, 4) RC(2, 5) RC(2, 6) RC(2, 7) RC(2, 8) RC(2, 9) RC(2, 10) RC(2, 11) RC(2, 12) RC(2, 13)
                RC(3, 0) RC(3, 1) RC(3, 2) RC(3, 3) RC(3, 4) RC(3, 5) RC(3, 6) RC(3, 7) RC(3, 8) RC(3, 9) RC(3, 10) RC(3, 11) RC(3, 12) RC(3, 13)
                RC(4, 0) RC(4, 1)                   RC(4, 2) RC(4, 5) RC(4, 6) RC(4, 7) RC(4, 8) RC(4, 9)                     RC(4, 12) RC(4, 13)
                                                             RC(5, 5)                   RC(5, 8)
        >;
    };
};

layout: layout {
        compatible = "zmk,physical-layout";
        display-name = "Split 6x7";
        transform = <&transform>;
        kscan = <&kscan>;

        keys  //                     w   h    x    y     rot    rx    ry
            = <&key_physical_attrs 150 100    0    50       0     0     0>
            , <&key_physical_attrs 100 100  150    50       0     0     0>
            , <&key_physical_attrs 100 100  250    25       0     0     0>
            , <&key_physical_attrs 100 100  350    0        0     0     0>
            , <&key_physical_attrs 100 100  450    25       0     0     0>
            , <&key_physical_attrs 100 100  550    50       0     0     0>
            , <&key_physical_attrs 100 100  675    50       0     0     0>
            , <&key_physical_attrs 100 100  775    50       0     0     0>
            , <&key_physical_attrs 100 100  900    50       0     0     0>
            , <&key_physical_attrs 100 100 1000    25       0     0     0>
            , <&key_physical_attrs 100 100 1100    0        0     0     0>
            , <&key_physical_attrs 100 100 1200    25       0     0     0>
            , <&key_physical_attrs 100 100 1300    50       0     0     0>
            , <&key_physical_attrs 150 100 1400    50       0     0     0>

            , <&key_physical_attrs 150 100    0    150       0     0     0>
            , <&key_physical_attrs 100 100  150    150       0     0     0>
            , <&key_physical_attrs 100 100  250    125       0     0     0>
            , <&key_physical_attrs 100 100  350    100       0     0     0>
            , <&key_physical_attrs 100 100  450    125       0     0     0>
            , <&key_physical_attrs 100 100  550    150       0     0     0>
            , <&key_physical_attrs 100 100  675    150       0     0     0>
            , <&key_physical_attrs 100 100  775    150       0     0     0>
            , <&key_physical_attrs 100 100  900    150       0     0     0>
            , <&key_physical_attrs 100 100 1000    125       0     0     0>
            , <&key_physical_attrs 100 100 1100    100       0     0     0>
            , <&key_physical_attrs 100 100 1200    125       0     0     0>
            , <&key_physical_attrs 100 100 1300    150       0     0     0>
            , <&key_physical_attrs 150 100 1400    150       0     0     0>

            , <&key_physical_attrs 150 100    0    250       0     0     0>
            , <&key_physical_attrs 100 100  150    250       0     0     0>
            , <&key_physical_attrs 100 100  250    225       0     0     0>
            , <&key_physical_attrs 100 100  350    200       0     0     0>
            , <&key_physical_attrs 100 100  450    225       0     0     0>
            , <&key_physical_attrs 100 100  550    250       0     0     0>
            , <&key_physical_attrs 100 100  675    250       0     0     0>
            , <&key_physical_attrs 100 100  775    250       0     0     0>
            , <&key_physical_attrs 100 100  900    250       0     0     0>
            , <&key_physical_attrs 100 100 1000    225       0     0     0>
            , <&key_physical_attrs 100 100 1100    200       0     0     0>
            , <&key_physical_attrs 100 100 1200    225       0     0     0>
            , <&key_physical_attrs 100 100 1300    250       0     0     0>
            , <&key_physical_attrs 150 100 1400    250       0     0     0>

            , <&key_physical_attrs 150 100    0    350       0     0     0>
            , <&key_physical_attrs 100 100  150    350       0     0     0>
            , <&key_physical_attrs 100 100  250    325       0     0     0>
            , <&key_physical_attrs 100 100  350    300       0     0     0>
            , <&key_physical_attrs 100 100  450    325       0     0     0>
            , <&key_physical_attrs 100 100  550    350       0     0     0>
            , <&key_physical_attrs 100 100  675    350       0     0     0>
            , <&key_physical_attrs 100 100  775    350       0     0     0>
            , <&key_physical_attrs 100 100  900    350       0     0     0>
            , <&key_physical_attrs 100 100 1000    325       0     0     0>
            , <&key_physical_attrs 100 100 1100    300       0     0     0>
            , <&key_physical_attrs 100 100 1200    325       0     0     0>
            , <&key_physical_attrs 100 100 1300    350       0     0     0>
            , <&key_physical_attrs 150 100 1400    350       0     0     0>

            , <&key_physical_attrs 150 100    0    450       0     0     0>
            , <&key_physical_attrs 100 100  100    450       0     0     0>
            , <&key_physical_attrs 100 100  462    495       15    512   545>
            , <&key_physical_attrs 100 100  558    521       15    608   571>
            , <&key_physical_attrs 100 100  655    547       15    705   597>
            , <&key_physical_attrs 100 100  775    544       345   825   594>
            , <&key_physical_attrs 100 100  872    518       345   922   568>
            , <&key_physical_attrs 100 100  968    492       345   1018  542>
            , <&key_physical_attrs 100 100  1350   450       0     0     0>
            , <&key_physical_attrs 100 100  1450   450       0     0     0>

            , <&key_physical_attrs 200 100  483    617       15    583   667>
            , <&key_physical_attrs 200 100  847    615       345   947   665>
            ;
    };

&i2c0 {
	status = "okay";
    pinctrl-0 = <&i2c0_default>;
    pinctrl-1 = <&i2c0_sleep>;
	oled: sh1106@3c {
        compatible = "solomon,ssd1306fb";
        reg = <0x3c>;
        width = <128>;
        height = <64>;
        segment-offset = <0>;
        page-offset = <0>;
        display-offset = <0>;
        multiplex-ratio = <63>;
        segment-remap;
        com-invdir;
        com-sequential;
        inversion-on;
        prechargep = <0x22>;
	};
};