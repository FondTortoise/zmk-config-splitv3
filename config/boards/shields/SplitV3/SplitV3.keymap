#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/rgb.h>
#include <dt-bindings/zmk/bt.h>

#define DEFAULT 0
#define SETTINGS 1

/ {
        keymap {
                compatible = "zmk,keymap";

                default_layer {
// -----------------------------------------------------------------------------------------
// |  ESC |  1  |  2  |  3  |  4  |  5  |  -  |   |  +  |  6  |  7   |  8  |  9  |  0  | BSPC |
// |  TAB |  Q  |  W  |  E  |  R  |  T  |LBRKT|   |RBRKT|  Y  |  U   |  I  |  O  |  P  |  DEL |
// | CAPS |  A  |  S  |  D  |  F  |  G  | APOS|   | SLSH|  H  |  J   |  K  |  L  | CLN |  ENT |
// | LSHFT|  Z  |  X  |  C  |  V  |  B  | PGUP|   | PGDN|  N  |  M   |  ,  |  .  |  /  | RSHFT|
// | CTRL | WIN |           |  UP | DWN | ALT |   | HME | LFT | RGHT |           |  FN | CTRL |
//                                | SPC |               | SPC |   
                        bindings = <
//   &kp ESC    &kp N1    &kp N2  &kp N3  &kp N4  &kp N5     &kp MINUS       &kp PLUS   &kp N6     &kp N7     &kp N8     &kp N9   &kp N0    &kp BSPC
//   &kp TAB    &kp Q     &kp W   &kp E   &kp R   &kp T      &kp LBKT        &kp RBKT   &kp Y      &kp U      &kp I      &kp O    &kp P     &kp DEL
//   &kp CAPS   &kp A     &kp S   &kp D   &kp F   &kp G      &kp APOS        &kp BSLH   &kp H      &kp J      &kp K      &kp L    &kp SEMI  &kp RET
//   &kp LSHFT  &kp Z     &kp X   &kp C   &kp V   &kp B      &kp PG_UP       &kp PG_DN  &kp N      &kp M      &kp COMMA  &kp DOT  &kp FSLH  &kp RSHFT
//   &kp LCTRL  &kp LGUI                  &kp UP  &kp DOWN   &kp LALT        &kp HOME   &kp LEFT   &kp RIGHT                      &kp A     &kp RCTRL
//                                                &kp SPACE                             &kp SPACE

&kp EQUAL  &kp N6     &kp N7     &kp N8     &kp N9   &kp N0             &kp BSPC
&kp RBKT   &kp Y      &kp U      &kp I      &kp O    &kp P              &kp DEL
&kp BSLH   &kp H      &kp J      &kp K      &kp L    &kp SEMI           &kp RET
&kp PG_DN  &kp N      &kp M      &kp COMMA  &kp DOT  &kp FSLH           &kp RSHFT
&kp HOME   &kp LEFT   &kp RIGHT                      &to SETTINGS       &kp RCTRL
           &kp SPACE
                        >; 
                };

        settings_layer {
                        bindings = <
&bt BT_CLR      &kp N6     &kp N7     &kp N8     &kp N9   &kp N0             &kp BSPC
&bt BT_SEL 0    &kp A      &kp U      &kp I      &kp O    &kp P              &kp DEL
&bt BT_SEL 1    &kp H      &kp J      &kp K      &kp L    &kp SEMI           &kp RET
&bt BT_SEL 2    &kp N      &kp M      &kp COMMA  &kp DOT  &kp FSLH           &kp RSHFT
&bt BT_SEL 3    &bt BT_PRV &bt BT_NXT                     &to DEFAULT        &bootloader
                &kp SPACE
                        >; 
                };
        };
};
