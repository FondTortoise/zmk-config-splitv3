#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/rgb.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/ext_power.h>

#define DEFAULT 0
#define SETTINGS 1

/ {
        behaviors {
        hm: homerow_mods {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            tapping-term-ms = <150>;
            flavor = "tap-preferred";
            require-prior-idle-ms = <125>;
            bindings = <&kp>, <&kp>;
                };
        };
        keymap {
                compatible = "zmk,keymap";

                default_layer {
// -----------------------------------------------------------------------------------------
// |  ESC |  1  |  2  |  3  |  4  |  5  |  -  |   |  +  |  6  |  7   |  8  |  9  |  0  | BSPC |
// |  TAB |  Q  |  W  |  E  |  R  |  T  |LBRKT|   |RBRKT|  Y  |  U   |  I  |  O  |  P  |  DEL |
// | CAPS |  A  |  S  |  D  |  F  |  G  | APOS|   | SLSH|  H  |  J   |  K  |  L  | CLN |  ENT |
// | LSHFT|  Z  |  X  |  C  |  V  |  B  | PGUP|   | PGDN|  N  |  M   |  ,  |  .  |  /  | RSHFT|
// | CTRL | WIN |           |  UP | DWN | ALT |   | HME | LFT | RGHT |           |  FN | CTRL |
//                                | SPC |               | SPC |   
                        bindings = <
   &kp ESC    &kp N1    &kp N2  &kp N3  &kp N4  &kp N5     &kp MINUS       &kp EQUAL   &kp N6     &kp N7     &kp N8     &kp N9   &kp N0           &kp BSPC
   &kp TAB    &kp Q     &kp W   &kp E   &kp R   &kp T      &kp LBKT        &kp RBKT    &kp Y      &kp U      &kp I      &kp O    &kp P            &kp DEL
   &kp CAPS   &kp A     &kp S   &kp D   &kp F   &kp G      &kp APOS        &kp BSLH    &kp H      &kp J      &kp K      &kp L    &kp SEMI         &kp RET
   &kp LSHFT  &kp Z     &kp X   &kp C   &kp V   &kp B      &kp PG_UP       &kp PG_DN   &kp N      &kp M      &kp COMMA  &kp DOT  &kp FSLH         &kp RSHFT
   &kp LCTRL  &kp LGUI                  &kp UP  &kp DOWN   &to SETTINGS    &kp HOME    &kp LEFT   &kp RIGHT                      &to SETTINGS     &kp RCTRL
                                                &kp SPACE                              &kp SPACE
                        >; 
                };

        settings_layer {
                        bindings = <
   &kp ESC    &kp N1    &kp N2  &kp N3  &kp N4  &kp N5     &bt BT_CLR      &bt BT_CLR_ALL   &kp N6     &kp N7     &kp N8     &kp N9   &kp N0          &kp BSPC
   &kp TAB    &kp Q     &kp W   &kp E   &kp R   &kp T      &bt BT_SEL 0    &bt BT_SEL 3     &kp Y      &kp U      &kp I      &kp O    &kp P           &kp DEL
   &kp CAPS   &kp A     &kp S   &kp D   &kp F   &kp G      &bt BT_SEL 1    &bt BT_SEL 4     &kp H      &kp J      &kp K      &kp L    &kp SEMI        &kp RET
   &kp LSHFT  &kp Z     &kp X   &kp C   &kp V   &kp B      &bt BT_SEL 2    &out OUT_TOG     &kp N      &kp M      &kp COMMA  &kp DOT  &kp FSLH        &kp RSHFT
   &kp LCTRL  &kp LGUI                  &kp UP  &kp DOWN   &to DEFAULT     &kp HOME         &kp LEFT   &kp RIGHT                      &to DEFAULT     &kp RCTRL
                                                &kp SPACE                                   &kp SPACE

                        >; 
                };
        };
};
