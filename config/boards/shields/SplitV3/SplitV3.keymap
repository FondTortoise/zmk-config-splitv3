#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/rgb.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/ext_power.h>

#define DEFAULT 0
#define FUNCTION 1
#define SETTINGS 2
#define STEELSERIES 3

// -----------------------------------------------------------------------------------------
// |  ESC |  1  |  2  |  3  |  4  |  5  |  -  |   |  +  |  6  |  7   |  8  |  9  |  0  | BSPC |
// |  TAB |  Q  |  W  |  E  |  R  |  T  |LBRKT|   |RBRKT|  Y  |  U   |  I  |  O  |  P  |  DEL |
// | CAPS |  A  |  S  |  D  |  F  |  G  | APOS|   | SLSH|  H  |  J   |  K  |  L  | CLN |  ENT |
// | LSHFT|  Z  |  X  |  C  |  V  |  B  | PGUP|   | PGDN|  N  |  M   |  ,  |  .  |  /  | RSHFT|
// | CTRL | WIN |           |  UP | DWN | ALT |   | ALT | LFT | RGHT |           |  FN | CTRL |
//                                | SPC |               | SPC |   

/ {
        macros {
                dsc: dsc {
                compatible = "zmk,behavior-macro";
                #binding-cells = <0>;
                bindings =  <&macro_press &kp LGUI>,
                                <&macro_release &kp LGUI>,
                                <&macro_tap &kp D &kp I &kp S &kp C &kp O &kp R &kp D>,
                                <&macro_tap &kp RET>;

                };
                chrm: chrm {
                compatible = "zmk,behavior-macro";
                #binding-cells = <0>;
                bindings =  <&macro_press &kp LGUI>,
                                <&macro_release &kp LGUI>,
                                <&macro_tap &kp C &kp H &kp R &kp O &kp M &kp E>,
                                <&macro_tap &kp RET>;
                };
                stm: stm {
                compatible = "zmk,behavior-macro";
                #binding-cells = <0>;
                bindings =  <&macro_press &kp LGUI>,
                                <&macro_release &kp LGUI>,
                                <&macro_tap &kp S &kp T &kp E &kp A &kp M>,
                                <&macro_tap &kp RET>;
                };
                bmbu: bmbu {
                compatible = "zmk,behavior-macro";
                #binding-cells = <0>;
                bindings =  <&macro_press &kp LGUI>,
                                <&macro_release &kp LGUI>,
                                <&macro_tap &kp B &kp A &kp M &kp B &kp U>,
                                <&macro_tap &kp RET>;
                };
                fsn: fsn {
                compatible = "zmk,behavior-macro";
                #binding-cells = <0>;
                bindings =  <&macro_press &kp LGUI>,
                                <&macro_release &kp LGUI>,
                                <&macro_tap &kp F &kp U &kp S &kp I &kp O &kp N>,
                                <&macro_tap &kp RET>;
                };
                stls: stls {
                compatible = "zmk,behavior-macro";
                #binding-cells = <0>;
                bindings =  <&macro_press &kp LGUI>,
                                <&macro_release &kp LGUI>,
                                <&macro_tap &kp S &kp T &kp E &kp E &kp L &kp S &kp E &kp R &kp I &kp E &kp S>,
                                <&macro_tap &kp RET>;
                };
        };

        behaviors {
        hm: homerow_mods {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            tapping-term-ms = <150>;
            flavor = "tap-preferred";
            require-prior-idle-ms = <125>;
            bindings = <&kp>, <&kp>;
                };
        };
        keymap {
                compatible = "zmk,keymap";

                default_layer {
                sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;
                        bindings = <
   &kp ESC    &kp N1    &kp N2  &kp N3  &kp N4  &kp N5     &kp MINUS       &kp EQUAL    &kp N6     &kp N7     &kp N8     &kp N9   &kp N0        &kp BSPC
   &kp TAB    &kp Q     &kp W   &kp E   &kp R   &kp T      &kp LBKT        &kp RBKT     &kp Y      &kp U      &kp I      &kp O    &kp P         &kp DEL
   &kp CAPS   &kp A     &kp S   &kp D   &kp F   &kp G      &kp APOS        &kp BSLH     &kp H      &kp J      &kp K      &kp L    &kp SEMI      &kp RET
   &kp LSHFT  &kp Z     &kp X   &kp C   &kp V   &kp B      &kp PG_UP       &kp PG_DN    &kp N      &kp M      &kp COMMA  &kp DOT  &kp FSLH      &kp RSHFT
   &kp LCTRL  &kp LGUI                  &kp UP  &kp DOWN   &kp LALT        &kp RALT     &kp LEFT   &kp RIGHT                      &mo FUNCTION  &kp RCTRL
                                                &kp SPACE                  &kp C_MUTE   &kp SPACE
                        >; 
                };

        function_layer {
        sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;
                        bindings = <
   &kp ESC    &kp F1    &kp F2  &kp F3  &kp F4  &kp F5     &to STEELSERIES      &stm           &kp F6     &kp F7     &kp F8     &kp F9   &kp F10         &kp BSPC
   &kp TAB    &kp Q     &kp W   &kp E   &kp R   &kp T      &to DEFAULT          &stls          &kp Y      &kp U      &kp I      &kp O    &kp P           &kp DEL
   &kp CAPS   &kp A     &kp S   &kp D   &kp F   &kp G      &dsc                 &fsn           &kp H      &kp J      &kp K      &kp L    &kp SEMI        &kp RET
   &kp LSHFT  &kp Z     &kp X   &kp C   &kp V   &kp B      &chrm                &bmbu          &kp N      &kp M      &kp COMMA  &kp DOT  &kp FSLH        &kp RSHFT
   &kp LCTRL  &kp LGUI                  &kp UP  &kp DOWN   &kp LALT             &kp RALT       &kp LEFT   &kp RIGHT                      &mo FUNCTION    &kp RCTRL
                                                &kp SPACE                       &to SETTINGS   &kp SPACE

                        >; 
                };

        settings_layer {
        sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;
                        bindings = <
   &kp ESC    &kp N1    &kp N2  &kp N3  &kp N4  &kp N5     &bt BT_CLR      &bt BT_CLR_ALL   &kp N6     &kp N7     &kp N8     &kp N9   &kp N0          &kp BSPC
   &kp TAB    &kp Q     &kp W   &kp E   &kp R   &kp T      &bt BT_SEL 0    &bt BT_SEL 3     &kp Y      &kp U      &kp I      &kp O    &kp P           &kp DEL
   &kp CAPS   &kp A     &kp S   &kp D   &kp F   &kp G      &bt BT_SEL 1    &bt BT_SEL 4     &kp H      &kp J      &kp K      &kp L    &kp SEMI        &kp RET
   &kp LSHFT  &kp Z     &kp X   &kp C   &kp V   &kp B      &bt BT_SEL 2    &out OUT_TOG     &kp N      &kp M      &kp COMMA  &kp DOT  &kp FSLH        &kp RSHFT
   &kp LCTRL  &kp LGUI                  &kp UP  &kp DOWN   &kp LALT        &kp HOME         &kp LEFT   &kp RIGHT                      &mo FUNCTION    &kp RCTRL
                                                &kp SPACE                  &to DEFAULT      &kp SPACE

                        >; 
                };

        steelseries_layer {
        sensor-bindings = <&inc_dec_kp F10 F9>;
                        bindings = <
   &kp ESC    &kp N1    &kp N2  &kp N3  &kp N4  &kp N5     &kp MINUS       &kp EQUAL    &kp N6     &kp N7     &kp N8     &kp N9   &kp N0       &kp BSPC
   &kp TAB    &kp Q     &kp W   &kp E   &kp R   &kp T      &kp LBKT        &kp RBKT     &kp Y      &kp U      &kp I      &kp O    &kp P        &kp DEL
   &kp CAPS   &kp A     &kp S   &kp D   &kp F   &kp G      &kp APOS        &kp BSLH     &kp H      &kp J      &kp K      &kp L    &kp SEMI     &kp RET
   &kp LSHFT  &kp Z     &kp X   &kp C   &kp V   &kp B      &kp PG_UP       &kp PG_DN    &kp N      &kp M      &kp COMMA  &kp DOT  &kp FSLH     &kp RSHFT
   &kp LCTRL  &kp LGUI                  &kp UP  &kp DOWN   &kp LALT        &kp RALT     &kp LEFT   &kp RIGHT                      &to DEFAULT  &kp RCTRL
                                                &kp SPACE                  &kp F11   &kp SPACE
                        >; 
                };
        };
};
